<Project>

  <!-- The executables embed third-party content (the BIP39 wordlist, MIT), so its notice
       ships beside them in every build and publish output. A .targets file because each
       project's OutputType is only known after Directory.Build.props has been read. -->
  <ItemGroup Condition="'$(OutputType)' == 'Exe'">
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The strip half of the macOS symbol pass that Directory.Build.props turns off (it keeps
       dsymutil off): the same command the Native AOT targets run after linking. -->
  <Target Name="StripMacNativeBinary" AfterTargets="LinkNative"
          Condition="$(RuntimeIdentifier.StartsWith('osx')) and '$(PublishAot)' == 'true' and '$(NativeBinary)' != ''">
    <Exec Command="strip -no_code_signature_warning -x &quot;$(NativeBinary)&quot;" />
  </Target>

</Project>
